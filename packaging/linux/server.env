# PassZit server configuration. Restart after changes:
#   systemctl restart passzit-server

# PostgreSQL connection (required; install.sh fills it in).
PASSZIT_DB=postgres://passzit:CHANGE_ME@127.0.0.1:5432/passzit?sslmode=disable

# Where updates come from (default: the official GitHub releases). A mirror
# or a local directory (file:///srv/passzit-releases) holds the files of
# a release side by side; they must still carry the release signature.
#PASSZIT_UPDATE_SOURCE=
